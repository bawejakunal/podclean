# Gemini API Key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Whisper backend: mlx | faster-whisper
# If unset, PodClean picks: macOS (Darwin) → mlx, otherwise faster-whisper.
# An installed backend that does not match the platform default (e.g. faster-whisper
# on an Intel Mac) is used automatically. Override only when you need to force one.
# WHISPER_BACKEND=faster-whisper

# Whisper model. IDs differ by backend — leave unset to use the backend default:
#   mlx:            mlx-community/whisper-large-v3-turbo
#   faster-whisper: large-v3-turbo
# WHISPER_MODEL=large-v3-turbo

# Device / compute type (mainly used by faster-whisper).
# Defaults: mlx → gpu/int8; faster-whisper → cpu/int8 (cuda when available).
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Output audio format: mp3, wav, m4a
OUTPUT_FORMAT=mp3

# Output audio bitrate
OUTPUT_BITRATE=192k

# Crossfade duration in milliseconds between cuts
CROSSFADE_MS=300

# AWS S3 Configuration (Optional, for mobile uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION_NAME=us-east-1

# Resend Notification Configuration (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_RECIPIENT=
