# Gemini API Key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Whisper model to use (requires a valid MLX HuggingFace repo ID)
# mlx-community/whisper-large-v3-turbo is highly recommended for accuracy and speed.
WHISPER_MODEL="mlx-community/whisper-large-v3-turbo"

# Output audio format: mp3, wav, m4a
OUTPUT_FORMAT=mp3

# Output audio bitrate
OUTPUT_BITRATE=192k

# Crossfade duration in milliseconds between cuts
CROSSFADE_MS=300

# AWS S3 Configuration (Optional, for mobile uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION_NAME=us-east-1

# Newest episodes kept in the public S3 RSS file (rss.xml). 0 = unlimited.
# 300 stays well under the ~512 KiB size where some podcast apps time out.
RSS_MAX_ITEMS=300
# Soft cap on player-facing rss.xml size in bytes. 0 = unlimited.
RSS_MAX_BYTES=524288

# Resend Notification Configuration (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_RECIPIENT=
