# Gemini API Key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Whisper model to use (tiny, base, small, medium, large-v3)
# large-v3 is highly recommended for accuracy, though slower on older hardware.
WHISPER_MODEL="large-v3"

# Output audio format: mp3, wav, m4a
OUTPUT_FORMAT=mp3

# Output audio bitrate
OUTPUT_BITRATE=192k

# Crossfade duration in milliseconds between cuts
CROSSFADE_MS=300

# AWS S3 Configuration (Optional, for mobile uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION_NAME=us-east-1

# Resend Notification Configuration (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_RECIPIENT=
